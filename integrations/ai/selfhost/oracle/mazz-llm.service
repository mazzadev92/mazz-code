[Unit]
Description=MAZZ self-hosted OpenAI-compatible inference endpoint
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mazz/oracle
ExecStart=/usr/bin/docker compose --profile oracle up -d llama.cpp
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
