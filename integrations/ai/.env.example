# MAZZ Control - cles des fournisseurs IA. Copiez ce fichier en `.env` (jamais commite) et collez vos cles.
# Une cle collee est prise en compte en moins de 5 s, sans redemarrage. Valeurs vides = fournisseur ignore.
# Cle optionnelle sans compte : mettez `anonymous` (llm7, ovh_endpoints, local_*).

# Interrupteur general : false = l'application se comporte exactement comme avant.
AI_ROUTER_ENABLED=false
# Fichier d'etat (breaker, quotas). Vide = %USERPROFILE%\.mazz\router_state.json
AI_ROUTER_STATE=

# --- Auto-heberges (essayes en premier)
# Oracle VM (vLLM / llama.cpp) - https://www.oracle.com/cloud/free/
LOCAL_ORACLE_KEY=
LOCAL_ORACLE_URL=
# AI_LOCAL_ORACLE_DISABLED=1   (couper ce fournisseur sans toucher au registre)
# Modal (vos poids) - https://modal.com/
LOCAL_MODAL_KEY=
LOCAL_MODAL_URL=
# AI_LOCAL_MODAL_DISABLED=1   (couper ce fournisseur sans toucher au registre)
# Hugging Face Space (endpoint vLLM) - https://huggingface.co/spaces
LOCAL_HF_SPACE_KEY=
HF_SPACE_USER=
HF_SPACE_NAME=
# AI_LOCAL_HF_SPACE_DISABLED=1   (couper ce fournisseur sans toucher au registre)

# --- Chat (gratuits, par priorite)
# NVIDIA NIM - https://build.nvidia.com/
NIM_KEY=
# AI_NIM_DISABLED=1   (couper ce fournisseur sans toucher au registre)
# Groq - https://console.groq.com/
GROQ_KEY=
# AI_GROQ_DISABLED=1   (couper ce fournisseur sans toucher au registre)
# AMD Radeon Cloud - https://developer.amd.com/ai-developer-program/
AMD_RADEON_KEY=
# AI_AMD_RADEON_DISABLED=1   (couper ce fournisseur sans toucher au registre)
# Google AI Studio (Gemini) - https://aistudio.google.com/
AISTUDIO_KEY=
# AI_AISTUDIO_DISABLED=1   (couper ce fournisseur sans toucher au registre)
# Cerebras - https://cloud.cerebras.ai/
CEREBRAS_KEY=
# AI_CEREBRAS_DISABLED=1   (couper ce fournisseur sans toucher au registre)
