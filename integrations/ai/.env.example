MODELSCOPE_KEY=
# AI_MODELSCOPE_DISABLED=1   (couper ce fournisseur sans toucher au registre)
# Z.ai (Zhipu GLM) - https://z.ai/
ZAI_KEY=
# AI_ZAI_DISABLED=1   (couper ce fournisseur sans toucher au registre)
# LLM7.io - https://llm7.io/
LLM7_KEY=
